DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POSTGRES_DB=manual_assistant
POSTGRES_USER=manual_app
POSTGRES_PASSWORD=manual_app_dev_pw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# RAG provider settings. Leave EMBEDDING_PROVIDER/LLM_PROVIDER as "local" until
# organizer-issued API keys are available. See README for how to switch providers.
EMBEDDING_PROVIDER=local
LLM_PROVIDER=local
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Dual-Answer RAG: Groq provider settings (separate from EMBEDDING_PROVIDER/
# LLM_PROVIDER above, which stay "local"). Leave LLM_ENABLED=False and
# GROQ_API_KEY blank until you have a real key - the app works normally with
# RAG-only answers either way. See README "Dual-Answer RAG" for details.
LLM_ENABLED=False
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT=30
